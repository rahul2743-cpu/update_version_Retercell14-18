NEIGHBOUR_QUERY_TMPL = PREFIXES + """
SELECT ?src ?srcLabel ?pred ?predLabel ?tgt ?tgtLabel
       ?description ?strength ?linkType
WHERE {
    VALUES ?src { %SEEDS% }
    ?stmt a rdf:Statement ;
          rdf:subject   ?src ;
          rdf:predicate ?pred ;
          rdf:object    ?tgt ;
          ex:description ?description ;
          ex:strength    ?strength ;
          ex:linkType    ?linkType .
    OPTIONAL { ?src  rdfs:label ?srcLabel }
    OPTIONAL { ?tgt  rdfs:label ?tgtLabel }
    OPTIONAL { ?pred rdfs:label ?predLabel }
}
"""

DOC_CONTENT_TMPL = PREFIXES + """
SELECT ?doc ?label ?content
WHERE {
    VALUES ?doc { %DOCS% }
    ?doc ex:documentContent ?content .
    OPTIONAL { ?doc rdfs:label ?label }
}
"""

_STOP = {"the", "a", "an", "of", "for", "and", "or", "to", "in", "on", "is",
         "are", "what", "which", "how", "does", "do", "with", "by", "from"}


def _tokens(s):
    return {t for t in re.findall(r"[a-z0-9]+", (s or "").lower())
            if t not in _STOP and len(t) > 2}


def _token_score(phrase_tokens, label_tokens):
    """Recall-weighted overlap, 0-100. Full label coverage (recall=1.0)
    is what indicates 'this label is what the phrase is about' -- extra
    qualifier words in the phrase (lower precision) should only lightly
    discount that, not disqualify it."""
    if not phrase_tokens or not label_tokens:
        return 0.0
    inter = phrase_tokens & label_tokens
    if not inter:
        return 0.0
    recall = len(inter) / len(label_tokens)
    precision = len(inter) / len(phrase_tokens)
    RECALL_WEIGHT = 0.75
    return 100.0 * (RECALL_WEIGHT * recall + (1 - RECALL_WEIGHT) * precision)


def _values_block(uris):
    return " ".join(f"<{u}>" for u in uris if "<" not in u and ">" not in u)


def link_entities(phrases):
    best = {}
    for phrase, _cls in phrases:
        p_tok = _tokens(phrase)

        if p_tok:
            for label_lc, nodes in LABEL_TO_NODES.items():
                score = _token_score(p_tok, _tokens(label_lc))
                if score < MATCH_CUTOFF:
                    continue
                for node in nodes:
                    if best.get(node, (0,))[0] < score:
                        best[node] = (score, phrase)

        for label_lc, score in fuzzy_match(phrase.lower(), ALL_LABELS,
                                           MAX_SEEDS_PER_PHRASE, MATCH_CUTOFF):
            for node in LABEL_TO_NODES[label_lc]:
                if node not in best or score > best[node][0]:
                    best[node] = (score, phrase)

    return [(n, NODE_LABEL.get(n, n), s, p)
            for n, (s, p) in sorted(best.items(), key=lambda kv: kv[1][0], reverse=True)]


def lexical_fallback(question, limit=5):
    q_tokens = _tokens(question)
    if not q_tokens:
        return []
    scored = []
    for label_lc, nodes in LABEL_TO_NODES.items():
        overlap = q_tokens & _tokens(label_lc)
        if overlap:
            score = 100.0 * len(overlap) / max(len(_tokens(label_lc)), 1)
            for n in nodes:
                scored.append((n, NODE_LABEL.get(n, n), min(score, 99.0), "lexical"))
    scored.sort(key=lambda x: x[2], reverse=True)
    return scored[:limit]


def traverse(seeds, debug=False):
    edges, seen = [], set()
    visited = {n: (0, s, n) for n, _l, s, _p in seeds}
    frontier = [n for n, _l, _s, _p in seeds]

    for hop in range(1, MAX_HOPS + 1):
        if not frontier or len(edges) >= MAX_EDGES:
            break
        if debug:
            print(f"\n--- HOP {hop} ---")
            print(f"Frontier nodes: {len(frontier)}")

        block = _values_block(frontier[:MAX_FRONTIER])
        if not block:
            break
        try:
            rows = list(g.query(NEIGHBOUR_QUERY_TMPL.replace("%SEEDS%", block)))
        except Exception as e:
            print(f"  hop {hop} query failed: {e}")
            break

        if debug:
            print(f"Rows returned: {len(rows)}")

        next_frontier = []
        added_this_hop = 0
        for row in rows:
            src, tgt = str(row.src), str(row.tgt)
            pred = str(row.predLabel) if row.predLabel else str(row.pred).rsplit("/", 1)[-1]
            key = (src, pred, tgt)
            if key in seen:
                continue
            seen.add(key)

            src_hop, src_score, src_seed_node = visited[src]

            edges.append({
                "source": src,
                "source_label": str(row.srcLabel) if row.srcLabel else NODE_LABEL.get(src, src),
                "predicate": pred,
                "target": tgt,
                "target_label": str(row.tgtLabel) if row.tgtLabel else NODE_LABEL.get(tgt, tgt),
                "description": str(row.description),
                "strength": int(row.strength),
                "link_type": str(row.linkType),
                "hop": hop,
                "seed_score": src_score,
                "seed_node": src_seed_node,
            })
            added_this_hop += 1

            if tgt not in visited:
                visited[tgt] = (hop, src_score, src_seed_node)
                next_frontier.append(tgt)

            if len(edges) >= MAX_EDGES:
                break
        frontier = next_frontier

        if debug:
            print(f"Edges added: {added_this_hop}")
            print(f"Next frontier: {len(frontier)}")

    return edges, visited


print("Defined: link_entities, lexical_fallback, traverse (outgoing-only, with seed provenance)")
