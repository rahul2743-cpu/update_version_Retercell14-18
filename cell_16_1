# ==========================================================
# Cell 16 : LINKING + TRAVERSAL  (SPARQL, no LLM)
#
#   ITERATED, NOT A PROPERTY PATH: SPARQL property paths require fixed
#   predicate IRIs -- variables are illegal inside a path -- and the
#   {n,m} cardinality forms were removed from SPARQL 1.1 before it was
#   finalised. With distinct predicates per relationship, the options
#   are a chained-statement query or an iterated 1-hop query. Iterating
#   wins: rdflib evaluates a chained double-statement pattern as a
#   near-cartesian join, and each hop multiplies it again.
#
#   OUTGOING ONLY: the walk follows ?src -> ?tgt only, like clicking
#   forward through hyperlinks -- Doc A's hop-1 frontier is whatever
#   A points to, hop-2 is whatever THOSE nodes point to, and so on.
#   VALUES binds ?src straight to the frontier, so the query IS
#   "outgoing edges of these nodes" -- not "any edge touching these
#   nodes" with half the result thrown away. An entity/parameter seed
#   (Cell 10 only ever writes those as ?tgt, never ?src) has no
#   outgoing edges and stops at hop 1 -- intentional, not a bug.
#
#   DEAD-END DIAGNOSTIC: after every traversal run, it's useful to
#   know WHICH reached nodes had nothing to walk out of them, and
#   WHY -- without ever naming a single title. diagnose_dead_ends()
#   answers that generically, straight from the graph + raw_df:
#     - already a document (in CONTENT_NODES)      -> genuinely has
#       no outgoing links, not a gap.
#     - resolves to a real page in raw_df, but was
#       never loaded as a source                    -> closure gap,
#       Cell 5b should have pulled it in (bump CLOSURE_HOPS /
#       MAX_CLOSURE_DOCS, or re-run Cell 5b -- xml_df may be stale).
#     - no matching page in raw_df at all            -> just a link
#       label / mention; there is no page to load.
# ==========================================================
print("=" * 80)
print("CELL 16 — LINKING + TRAVERSAL")
print("=" * 80)

NEIGHBOUR_QUERY_TMPL = PREFIXES + """
SELECT ?src ?srcLabel ?pred ?predLabel ?tgt ?tgtLabel
       ?description ?strength ?linkType
WHERE {
    VALUES ?src { %SEEDS% }
    ?stmt a rdf:Statement ;
          rdf:subject   ?src ;
          rdf:predicate ?pred ;
          rdf:object    ?tgt ;
          ex:description ?description ;
          ex:strength    ?strength ;
          ex:linkType    ?linkType .
    OPTIONAL { ?src  rdfs:label ?srcLabel }
    OPTIONAL { ?tgt  rdfs:label ?tgtLabel }
    OPTIONAL { ?pred rdfs:label ?predLabel }
}
"""

DOC_CONTENT_TMPL = PREFIXES + """
SELECT ?doc ?label ?content
WHERE {
    VALUES ?doc { %DOCS% }
    ?doc ex:documentContent ?content .
    OPTIONAL { ?doc rdfs:label ?label }
}
"""

SUBSTRING_TMPL = PREFIXES + """
SELECT DISTINCT ?node ?label
WHERE {
    ?node rdfs:label ?label .
    FILTER(CONTAINS(LCASE(STR(?label)), %PHRASE%))
    FILTER(!STRSTARTS(STR(?node), "%PREDMARK%"))
}
LIMIT 10
"""

# Every reified statement whose SUBJECT is a dead end -- i.e. that
# subject never shows up as an ?object anywhere either as a document
# that was actually processed. Used only by diagnose_dead_ends() below;
# kept as a template (not inline) for the same reason the others are.
DEAD_END_QUERY = PREFIXES + """
SELECT DISTINCT ?node ?label ?targetRef
WHERE {
    ?stmt a rdf:Statement ; rdf:object ?node .
    OPTIONAL { ?node rdfs:label ?label }
    OPTIONAL { ?node ex:targetReference ?targetRef }
    FILTER NOT EXISTS {
        ?stmt2 a rdf:Statement ; rdf:subject ?node .
    }
}
"""

_STOP = {"the", "a", "an", "of", "for", "and", "or", "to", "in", "on", "is",
         "are", "what", "which", "how", "does", "do", "with", "by", "from"}


def _tokens(s):
    return {t for t in re.findall(r"[a-z0-9]+", (s or "").lower())
            if t not in _STOP and len(t) > 2}


def _values_block(uris):
    return " ".join(f"<{u}>" for u in uris if "<" not in u and ">" not in u)


def _sparql_literal(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def link_entities(phrases):
    """Phrases -> [(node, label, score, phrase)]. Two passes: SPARQL
    substring for precision, fuzzy for recall."""
    best = {}
    for phrase, _cls in phrases:
        q = (SUBSTRING_TMPL
             .replace("%PHRASE%", _sparql_literal(phrase.lower()))
             .replace("%PREDMARK%", PREDICATE_MARKER))
        try:
            for row in g.query(q):
                node = str(row.node)
                if best.get(node, (0,))[0] < 95:
                    best[node] = (95.0, phrase)
        except Exception as e:
            print(f"  substring query failed for {phrase!r}: {e}")

        for label_lc, score in fuzzy_match(phrase.lower(), ALL_LABELS,
                                           MAX_SEEDS_PER_PHRASE, MATCH_CUTOFF):
            for node in LABEL_TO_NODES[label_lc]:
                if node not in best or score > best[node][0]:
                    best[node] = (score, phrase)

    return [(n, NODE_LABEL.get(n, n), s, p)
            for n, (s, p) in sorted(best.items(), key=lambda kv: kv[1][0], reverse=True)]


def lexical_fallback(question, limit=5):
    """No LLM, no embeddings. Used when extraction returns nothing or
    nothing links."""
    q_tokens = _tokens(question)
    if not q_tokens:
        return []
    scored = []
    for label_lc, nodes in LABEL_TO_NODES.items():
        overlap = q_tokens & _tokens(label_lc)
        if overlap:
            score = 100.0 * len(overlap) / max(len(_tokens(label_lc)), 1)
            for n in nodes:
                scored.append((n, NODE_LABEL.get(n, n), min(score, 99.0), "lexical"))
    scored.sort(key=lambda x: x[2], reverse=True)
    return scored[:limit]


def traverse(seeds):
    """Iterated SPARQL expansion -- one query per hop, OUTGOING edges
    only. The frontier passed into hop N+1 is exactly the set of ?tgt
    nodes newly reached at hop N (never the ?src side, which is already
    a seed or already visited by construction). This grows a directed
    subgraph -- seed -> hop1 targets -> hop2 targets -> ... -- the same
    way you'd fan out across Wikipedia by only clicking outgoing links,
    rather than an undirected ball that also pulls in everything that
    happens to link TO a node."""
    edges, seen, visited = [], set(), {n: (0, s) for n, _l, s, _p in seeds}
    frontier = [n for n, _l, _s, _p in seeds]

    for hop in range(1, MAX_HOPS + 1):
        if not frontier or len(edges) >= MAX_EDGES:
            break
        block = _values_block(frontier[:MAX_FRONTIER])
        if not block:
            break
        try:
            rows = list(g.query(NEIGHBOUR_QUERY_TMPL.replace("%SEEDS%", block)))
        except Exception as e:
            print(f"  hop {hop} query failed: {e}")
            break

        next_frontier = []
        for row in rows:
            src, tgt = str(row.src), str(row.tgt)
            pred = str(row.predLabel) if row.predLabel else str(row.pred).rsplit("/", 1)[-1]
            key = (src, pred, tgt)
            if key in seen:
                continue
            seen.add(key)

            edges.append({
                "source": src,
                "source_label": str(row.srcLabel) if row.srcLabel else NODE_LABEL.get(src, src),
                "predicate": pred,
                "target": tgt,
                "target_label": str(row.tgtLabel) if row.tgtLabel else NODE_LABEL.get(tgt, tgt),
                "description": str(row.description),
                "strength": int(row.strength),
                "link_type": str(row.linkType),
                "hop": hop,
                # src is always already visited (seed or a prior hop's target),
                # so its seed_score is the only side that can carry provenance
                "seed_score": visited.get(src, (0, 0))[1],
            })

            # outgoing-only: only ?tgt is a newly discovered node.
            if tgt not in visited:
                visited[tgt] = (hop, edges[-1]["seed_score"])
                next_frontier.append(tgt)

            if len(edges) >= MAX_EDGES:
                break
        frontier = next_frontier

    return edges, visited


# ----------------------------------------------------------
# Dead-end diagnostic -- fully generic, no title list anywhere.
# Reads the actual graph + raw_df to classify EVERY node the graph
# ever reaches as a target but never expands from.
# ----------------------------------------------------------

def _normalize_ref(s):
    """Same two rules as Cell 6 / Cell 8a / Cell 5b's normalize_ref_col,
    just in plain Python -- so a reference resolves here exactly the
    way it resolves everywhere else in the pipeline."""
    s = (s or "").strip()
    s = re.sub(r"^xwiki:", "", s)
    s = re.sub(r"\s+", "", s)
    return s


def diagnose_dead_ends(verbose=True):
    """Finds every node in `g` that is reached as an ?object of some
    reified statement but never appears as an ?object's rdf:subject --
    i.e. a node the outgoing-only traverse() can never expand past --
    and classifies each one into exactly one of three buckets using
    only data already in the pipeline (CONTENT_NODES from Cell 14,
    raw_df from Cell 4). Returns the three lists; nothing here is
    hardcoded to any specific title or document."""
    dead_ends = []
    for row in g.query(DEAD_END_QUERY):
        node = str(row.node)
        dead_ends.append({
            "node": node,
            "label": str(row.label) if row.label else NODE_LABEL.get(node, node),
            "target_reference": str(row.targetRef) if row.targetRef else None,
            "already_a_document": node in CONTENT_NODES,
        })

    ref_to_source = {
        _normalize_ref(r["reference"]): r["source"]
        for r in raw_df.select("reference", "source").distinct().collect()
    }

    genuine, closure_gap, no_page = [], [], []
    for d in dead_ends:
        if d["already_a_document"]:
            genuine.append(d)
            continue
        src = (ref_to_source.get(_normalize_ref(d["target_reference"]))
               if d["target_reference"] else None)
        (closure_gap if src else no_page).append({**d, "resolved_source": src})

    if verbose:
        print()
        print("-" * 80)
        print("DEAD-END DIAGNOSTIC")
        print("-" * 80)
        print(f"Dead-end nodes found in graph                   : {len(dead_ends)}")
        print(f"  already processed, genuinely no outgoing links : {len(genuine)}")
        print(f"  real page in raw_df, never loaded as a source  : {len(closure_gap)}  <- closure gap")
        print(f"  no matching page in raw_df at all               : {len(no_page)}")
        if closure_gap:
            print()
            print("Closure gaps (real pages Cell 5b should have pulled in):")
            display(spark.createDataFrame(closure_gap).select(
                "label", "target_reference", "resolved_source"))

    return genuine, closure_gap, no_page


print("Defined: link_entities, lexical_fallback, traverse, diagnose_dead_ends")

# Run once at cell-execution time so the diagnostic is always current
# for whatever graph `g` holds right now -- not something you have to
# remember to call separately after building/rebuilding the KG.
_genuine, _closure_gap, _no_page = diagnose_dead_ends()
