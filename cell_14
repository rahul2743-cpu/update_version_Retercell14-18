# ---- Config -------------------------------------------------------------
KG_BASE = BASE

MAX_HOPS = 2                 # 1 = direct facts only, 2 = adds sibling context
HOP_DECAY = 0.45             # hop-2 evidence worth ~45% of hop-1
MATCH_CUTOFF = 72            # fuzzy score floor, 0-100. Lower = more recall
MAX_SEEDS_PER_PHRASE = 3
MAX_FRONTIER = 60            # nodes carried into the next hop
MAX_EDGES = 400              # hard stop before ranking
GROUND_ENTITY_SEEDS = True
MAX_TRIPLES = 40
MAX_DOCS = 4
